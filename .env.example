# Copy to .env locally. Never share the API key in chat or screenshots.
LLM_MODE=fixture
# Chat Completions service root, e.g. https://api.deepseek.com
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_JSON_MODE=true
# DeepSeek supports thinking: disabled. Leave false for other services.
LLM_DISABLE_THINKING=true
LLM_MAX_TOKENS=4096
ENABLE_IMAGE_INPUT=false
